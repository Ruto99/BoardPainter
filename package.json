{
  "name": "boardpainter",
  "productName": "BoardPainter",
  "version": "1.21.0",
  "description": "無料のデジタルスカルプト（3D造形）デスクトップツール",
  "main": "electron/main.js",
  "author": "BoardPainter",
  "license": "MIT",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/vendor.js && node scripts/build-native.js",
    "start": "node scripts/vendor.js && electron .",
    "dist": "node scripts/vendor.js && node scripts/build-native.js --strict && electron-builder --publish never",
    "dist:win": "node scripts/vendor.js && node scripts/build-native.js --strict && electron-builder --win --publish never",
    "dist:mac": "node scripts/vendor.js && node scripts/build-native.js --strict && electron-builder --mac --publish never",
    "dist:linux": "node scripts/vendor.js && node scripts/build-native.js --strict && electron-builder --linux --publish never",
    "build:native": "node scripts/build-native.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "38.8.6",
    "electron-builder": "26.18.0",
    "manifold-3d": "^3.5.5",
    "meshoptimizer": "^1.3.0",
    "node-gyp": "^13.1.0",
    "three": "0.160.0",
    "three-mesh-bvh": "0.7.3"
  },
  "build": {
    "appId": "app.boardpainter.desktop",
    "productName": "BoardPainter",
    "copyright": "BoardPainter",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "blender/**",
      "native/build/Release/bp_native.node",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "native/build/Release/bp_native.node",
      "electron/mcp-server.js",
      "electron/agent-tools.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "BoardPainter",
      "artifactName": "${productName}-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "icon": "build/icon.png",
    "fileAssociations": [
      {
        "ext": "bpp",
        "name": "BoardPainter Project",
        "description": "BoardPainter プロジェクト",
        "role": "Editor"
      }
    ]
  }
}
